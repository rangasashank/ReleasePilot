POSTGRES_PASSWORD=releasepilot-local-only
DEMO_EMAIL=demo@releasepilot.local
DEMO_PASSWORD=local-demo-change-me
COOKIE_SECURE=false

# Run python3 scripts/configure-local.py to generate local secrets.
INTERNAL_SECRET=
GITHUB_WEBHOOK_SECRET=
OPENAI_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Mount a PEM file at .secrets/github-app.pem when using a GitHub App.
GITHUB_APP_PRIVATE_KEY_FILE=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Update the conservative price bound whenever changing the reasoning model.
AGENT_TIMEOUT_SECONDS=120
AGENT_TOKEN_BUDGET=32000
AGENT_COST_BUDGET_USD=0.06
MODEL_MAX_USD_PER_MILLION_TOKENS=1.6
